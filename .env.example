# Copie para .env.local e preencha apenas no computador de desenvolvimento.
# Nunca use prefixo VITE_ nesta credencial.
GEMINI_API_KEY=

# ElevenLabs Sound Effects API (development server only; never prefix with VITE_).
# Paid generations remain blocked unless BOTH flags below are explicitly true.
ELEVENLABS_API_KEY=
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v3
SFX_GENERATION_ENABLED=false
SFX_ALLOW_PAID_GENERATION=false
